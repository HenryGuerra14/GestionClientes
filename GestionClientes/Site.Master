<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.Master.vb" Inherits="GestionClientes.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - Gestión de Clientes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand navbar-dark bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand" href="Clientes.aspx">Gestión de Clientes</a>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="Clientes.aspx">Clientes</a></li>
                    <li class="nav-item"><a class="nav-link" href="Bitacora.aspx">Bitácora</a></li>
                </ul>
                <span class="navbar-text text-white me-3">Usuario: <strong><%: Context.User.Identity.Name %></strong></span>
                <asp:LinkButton ID="lnkSalir" runat="server" CssClass="btn btn-outline-light btn-sm" CausesValidation="false">Cerrar sesión</asp:LinkButton>
            </div>
        </nav>
        <main class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
    </form>
</body>
</html>
