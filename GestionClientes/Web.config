<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- LocalDB con autenticación Windows. Con SQL Server Express usar Server=.\SQLEXPRESS -->
    <add name="GestionClientesDB"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=GestionClientesDB;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Evita exigir jQuery para los validadores -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Clientes.aspx" timeout="30"
             slidingExpiration="true" cookieless="UseCookies" protection="All" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <httpCookies httpOnlyCookies="true" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
  </system.web>

  <location path="Error.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>

  <system.webServer>
    <defaultDocument>
      <files><clear /><add value="Clientes.aspx" /></files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
